# Example backend environment variables for Sankalp Arena
# Copy this file to .env and replace placeholders with real values.

MONGO_URL=your_mongodb_connection_string
DB_NAME=sankalp
JWT_SECRET=replace-with-a-secure-random-secret
INTEGRATION_PROXY_URL=https://your-integration-proxy.example.com
EMERGENT_LLM_KEY=your-emergent-llm-key
EMERGENT_EMAIL_KEY=your-emergent-email-key
EMAIL_FROM_NAME=SANKALP'26
EMAIL_REPLY_TO=your-email@example.com
BREVO_API_KEY=your-brevo-api-key
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-admin-password
JUDGE_EMAIL=judge@example.com
JUDGE_PASSWORD=replace-with-judge-password

SMTP_FROM_EMAIL=your-email@gmail.com
FRONTEND_URL=http://localhost:3000
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-brevo-smtp-username
SMTP_PASSWORD=your-brevo-smtp-password